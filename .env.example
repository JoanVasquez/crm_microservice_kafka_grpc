KAFKA_IMAGE=confluentinc/cp-kafka:7.7.1
KAFKA_CONTAINER_NAME=kafka
KAFKA_HOST=kafka
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CLIENT_PORT=9092
KAFKA_CLIENT_HOST_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_CONTROLLER_HOST_PORT=9093
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BROKERS=kafka:9092
USER_SERVICE_KAFKA_CLIENT_ID=user_service_client
USER_SERVICE_KAFKA_GROUP_ID=user-service-group
PRODUCT_SERVICE_KAFKA_CLIENT_ID=product_service_client
PRODUCT_SERVICE_KAFKA_GROUP_ID=product-service-group

REDIS_IMAGE=redis:7-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_URL=redis://redis:6379

POSTGRES_IMAGE=postgres:15
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
USER_DB_NAME=user_service_db
USER_DB_HOST=user-db
USER_DB_HOST_PORT=5433
PRODUCT_DB_NAME=product_service_db
PRODUCT_DB_HOST=product-db
PRODUCT_DB_HOST_PORT=5434
ORDER_DB_NAME=order_service_db
ORDER_DB_HOST=order-db
ORDER_DB_HOST_PORT=5435

NODE_ENV=development
API_GATEWAY_PORT=3000
API_GATEWAY_HOST_PORT=3000
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars
USER_SERVICE_HOST=user-service
USER_SERVICE_PORT=50051
USER_SERVICE_HOST_PORT=50051
PRODUCT_SERVICE_HOST=product-service
PRODUCT_SERVICE_PORT=50052
PRODUCT_SERVICE_HOST_PORT=50052
ORDER_SERVICE_HOST=order-service
ORDER_SERVICE_PORT=50053
ORDER_SERVICE_HOST_PORT=50053

PROMETHEUS_IMAGE=prom/prometheus:latest
PROMETHEUS_PORT=9090
PROMETHEUS_HOST_PORT=9090

GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_PORT=3000
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.8.0
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_HOST_PORT=9200
ELASTICSEARCH_DISCOVERY_TYPE=single-node
ELASTICSEARCH_SECURITY_ENABLED=false
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
ELASTICSEARCH_HOSTS=http://elasticsearch:9200

LOGSTASH_IMAGE=docker.elastic.co/logstash/logstash:8.8.0
LOGSTASH_PORT=5044
LOGSTASH_HOST_PORT=5044

KIBANA_IMAGE=docker.elastic.co/kibana/kibana:8.8.0
KIBANA_PORT=5601
KIBANA_HOST_PORT=5601

FILEBEAT_IMAGE=docker.elastic.co/beats/filebeat:8.8.0
